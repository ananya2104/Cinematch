# Azure OpenAI (Responses API)
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol

# TMDB
TMDB_READ_ACCESS_TOKEN=

# Watchmode
WATCHMODE_API_KEY=

# OMDb (optional - powers the real IMDb rating badge; get a free key at omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# App
STREAMING_REGION=IN
SESSION_TTL_MINUTES=120

# Optional — persistent, multi-instance-safe session storage. Unset = in-memory
# (fine for local dev / a single instance). e.g. redis://localhost:6379/0 for a
# local Redis (docker run -p 6379:6379 redis), or an Azure Cache for Redis URL.
REDIS_URL=

# Comma-separated origins allowed to call the API cross-origin. Only matters if
# the frontend is hosted separately from this backend (e.g. GitHub Pages).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://himanshu-bist-hb.github.io
